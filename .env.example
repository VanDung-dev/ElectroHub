# Set a password of at least 8 characters using at least 3 character groups.
MSSQL_SA_PASSWORD=
SQLSERVER_PORT=1433
APP_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# false for local HTTP; true when deployed behind HTTPS.
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=60
SQLSERVER_HOST=localhost
SQLSERVER_DATABASE=ElectroHub
SQLSERVER_USER=sa
# Local SQL Server uses a self-signed certificate. Use false with a trusted production cert.
SQLSERVER_TRUST_CERTIFICATE=true
# Public origin used for canonical URLs, sitemaps and payment return/IPN/webhook URLs.
# VNPAY return/IPN and the PayPal return/webhook are derived from this value.
SITE_URL=http://localhost:8000
# Optional SMTP settings for admin newsletter campaigns.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Optional customer support links (Subiz/Messenger/Zalo OA URL).
FACEBOOK_PAGE_URL=
ZALO_PAGE_URL=
# Paste the exact Subiz embed snippet from the Subiz account dashboard on one line.
SUBIZ_EMBED_CODE=
# Optional SQLAlchemy URL for external DB/test use. Compose uses SQLSERVER_* above.
# DATABASE_URL=

# mock = mô phỏng nội bộ (mặc định, dùng cho test); sandbox = gọi VNPAY/PayPal thật.
# Ở chế độ sandbox, app dừng ngay khi thiếu credential bên dưới.
PAYMENT_MODE=mock
# Số giờ giữ tiền trước khi shop được xác nhận hoàn tiền.
REFUND_HOLD_HOURS=72
# VAT mặc định cộng vào giá trị hàng sau giảm giá (phí giao hàng không chịu VAT).
VAT_PERCENT=10

# PayPal (sandbox). Return URL derive từ SITE_URL: /payments/paypal/return
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Bắt buộc khi PAYMENT_MODE=sandbox để xác minh webhook.
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_VND_PER_USD=25000

# VNPAY (sandbox). Return/IPN derive từ SITE_URL:
# /payments/vnpay/return và /api/v1/payments/vnpay/ipn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_EXPIRE_MINUTES=15
