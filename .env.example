# Set a password of at least 8 characters using at least 3 character groups.
MSSQL_SA_PASSWORD=
SQLSERVER_PORT=1433
APP_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# false for local HTTP; true when deployed behind HTTPS.
COOKIE_SECURE=true
ACCESS_TOKEN_MINUTES=60
SQLSERVER_HOST=localhost
SQLSERVER_DATABASE=ElectroHub
SQLSERVER_USER=sa
# Local SQL Server uses a self-signed certificate. Use false with a trusted production cert.
SQLSERVER_TRUST_CERTIFICATE=true
# Public origin used for canonical URLs, sitemaps and payment return URLs.
SITE_URL=https://electrohub.loca.lt
# Optional Stripe Checkout; use Stripe test keys and register /api/v1/payments/stripe-webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional SMTP settings for admin newsletter campaigns.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=ElectroHub <noreply@electrohub.loca.lt>
# Optional customer support links (Subiz/Messenger/Zalo OA URL).
FACEBOOK_PAGE_URL=
ZALO_PAGE_URL=
# Paste the exact Subiz embed snippet from the Subiz account dashboard on one line.
SUBIZ_EMBED_CODE=
# Optional SQLAlchemy URL for external DB/test use. Compose uses SQLSERVER_* above.
# DATABASE_URL=

PAYMENT_MODE=sandbox
REFUND_HOLD_HOURS=72

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_VND_PER_USD=25000
# PAYPAL_RETURN_URL=https://<tunnel>/payments/paypal/return

# VNPAY
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# VNPAY_RETURN_URL=https://<tunnel>/payments/vnpay/return
# VNPAY_IPN_URL=https://<tunnel>/api/v1/payments/vnpay/ipn
VNPAY_EXPIRE_MINUTES=15

# Localtunnel (tên miền dạng https://<subdomain>.loca.lt)
LOCALTUNNEL_SUBDOMAIN=electrohub

# tawk.to (Cần cả PROPERTY_ID và WIDGET_ID từ tawk.to để hiển thị widget chat)
PROPERTY_ID=
WIDGET_ID=

# Optional customer support links (Subiz/Messenger/Zalo OA URL).
FACEBOOK_PAGE_URL=
ZALO_PAGE_URL=
